# Defaults are OFF. Do not enable imports before source-specific permission is recorded.
ASSET_GENERATION_ENABLED=false
ASSET_WORKER_ENABLED=false
ASSET_AUTO_IMPORT_ENABLED=false
PIXELLAB_API_KEY=
SUPABASE_SECRET_KEY=
PHOTO_STORAGE_BUCKET=dog-photos
ASSET_STORAGE_BUCKET=dog-assets
# Maximum paid submission attempts per UTC day, not a dollar/credit spending cap.
ASSET_DAILY_REQUEST_LIMIT=10
# Docker supplies this path; local runs need Python with motion-requirements.txt.
ASSET_HARNESS_PYTHON=/opt/motion/bin/python
