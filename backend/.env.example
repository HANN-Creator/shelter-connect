# Local development only. Copy to .env; do not use these values remotely.
DB_URL='jdbc:postgresql://127.0.0.1:15432/shelter_connect'
DB_USERNAME=shelter_local
DB_PASSWORD=local-development-only
DB_POOL_SIZE=5
PORT=8080
SERVER_ADDRESS=127.0.0.1
# Set true only after confirming this is the local database.
DB_MIGRATE=false
# Public project URL, not a secret. Auth uses this project's ES256 public keys.
SUPABASE_URL='https://gwimdiwrqfcqulefshoz.supabase.co'
# Server-side only. Never copy this key into RN/web code or commit it.
AI_ENABLED=false
OPENAI_API_KEY=''
OPENAI_MODEL=gpt-5.6-luna
AI_TIMEOUT_SECONDS=30
# Private photo Storage: server-only secret key, never an RN/web key.
PHOTO_STORAGE_ENABLED=false
SUPABASE_SECRET_KEY=
PHOTO_STORAGE_BUCKET=dog-photos
PHOTO_STORAGE_TIMEOUT_SECONDS=5
