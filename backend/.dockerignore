# Only server build inputs may reach the builder. In particular, no .env files,
# local build output, sample tools, fixtures, logs, or frontend assets.
**
!Dockerfile
!.dockerignore
!gradlew
!build.gradle
!settings.gradle
!motion-requirements.txt
!certs/
!certs/supabase-prod-ca-2021.crt
!gradle/
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!src/
!src/main/
!src/main/**
**/.env
**/.env.*
!scripts/
!scripts/build_with_retry.sh
!scripts/export_gradle_cache.sh
!scripts/styled_dog/
!scripts/styled_dog/*.py
!asset-styles/
!asset-styles/cozy32-v1/
!asset-styles/cozy32-v1/rules.json
!asset-styles/cozy32-v1/style.png
