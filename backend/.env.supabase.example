# Copy to .env.supabase, then run with python3 scripts/run_supabase.py.
# This file uses literal values. Do not add shell quotes or source it.
# Port 5432 is intentional. Do not use the transaction pooler on port 6543.
DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
DB_POOL_SIZE=3
PORT=8080
